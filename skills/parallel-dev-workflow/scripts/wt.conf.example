# wt.conf —— 并行开发工作流的项目配置（复制为 wt.conf，与 wt.sh / lock.sh / wt_auto.sh 放在同一目录）
# 被 wt_auto.sh source；可用 $WT_CONF_DIR（本文件所在目录）拼路径。项目相关的东西只写在这里，三个脚本不改。

# ---- 目录 ----
# 外层根：功能线目录 wt/ 与锁目录 .locks/ 建在这里；各仓库主目录（集成线）一般也在这里。
# 下面两行按「<外层根>/_ai_workspace/<项目>/tools/wt.conf」的布局写，布局不同就改层级
WT_ROOT=$(cd "$WT_CONF_DIR/../../.." && pwd)
# 状态卡目录：一线一张 <线名>.md，收线后移入 _done/（放在 AI 工作区里，不进业务仓库）
WT_CARDS=$(cd "$WT_CONF_DIR/.." && pwd)/wt

# ---- 仓库 ----
# 每行 <短名>:<主目录>:<基线分支>:<线环境里指向它的变量名>
# 功能线在 <WT_ROOT>/wt/<线名>/<主目录名>/ 开 worktree，分支 feat/<线名> 自基线分支；
# 线没拉的仓库，该变量指向主目录（只读对账用）
WT_REPOS=(
    "app:$WT_ROOT/MyApp:main:APP_DIR"
    "fw:$WT_ROOT/MyFirmware:main:FW_DIR"
)
WT_DEFAULT_REPOS=app                 # wt.sh new 不带 --repos 时拉哪些（逗号分隔短名）
# 新 worktree 里从主目录硬链接拷一份的大目录（<短名>:<相对仓库根的路径>），秒级、不占双倍空间；
# 用硬链接树而不是软链：软链会让各线共享 .cache 之类的写入目录
WT_HARDLINK_DIRS=(
    "app:node_modules"
)

# ---- 线环境（写进 <线目录>/.wt.env）----
# 端口按线号错开，两条线可同时起回传接收器 / 转发：<变量名>:<基数>:<步长>，线号 n 得 基数 + 步长×n
WT_PORTS=(
    "SINK_PORT:8765:10"
    "FWD_PORT:18080:10"
)
# 其他变量（单引号，开线时展开；可用 $WT_DIR $WT_NAME $WT_SEQ）
WT_EXTRA_ENV=(
    'BUILD_OUT=$WT_DIR/build_out'
    'RUNDIR=/tmp/myproj-$WT_NAME'
)
# 开线后在线目录里跑一次的命令（可空），如首次整编放后台
WT_POST_NEW=''

# ---- 资源锁 ----
# 每行 <资源名>:<闲置留锁上限（分钟）>:<说明>
# 上限与「归还成本」挂钩：板子回基线约 1 分钟 → 10；手机要卸包清绑定 → 20；没有归还成本的工具锁 → 5
LOCK_RESOURCES=(
    "board-a:10:主板 192.168.1.10"
    "phone-android:20:安卓测试机（adb）"
    "phone-ios:20:iOS 测试机"
    "mac:10:Mac 打包机 / 模拟器"
)
# 板子 IP → 资源名（wt_auto.sh 的 board_res_of_ip 用）；没有板子留空数组
LOCK_IP_MAP=(
    "192.168.1.10=board-a"
)
LOCK_DEFAULT_TTL=30m                 # take 缺省租约
LOCK_IDLE_MARGIN=10                  # hold 的租约 = 预计空档 + 这么多分钟
